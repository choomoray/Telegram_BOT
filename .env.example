# =============================================================================
# Telegram 媒体管理机器人 - 环境变量配置模板
# =============================================================================
# 使用方式：
#   1. 复制此文件为 .env：   cp .env.example .env
#   2. 将占位值替换为你自己的配置
#   3. 启动机器人：           node index.js
#
# 必填项标记为 [必填]，其余为可选（已提供默认值）
# =============================================================================


# -----------------------------------------------------------------------------
# Telegram Bot Token [必填]
# -----------------------------------------------------------------------------
# 从 @BotFather (https://t.me/BotFather) 创建 Bot 后获取
# 格式：数字:字母数字组合
TELEGRAM_BOT_TOKEN=你的_Bot_Token


# -----------------------------------------------------------------------------
# MongoDB Atlas 连接串 [必填]
# -----------------------------------------------------------------------------
# 从 MongoDB Atlas 获取的连接串
MONGODB_URI=mongodb+srv://用户名:密码@集群地址.mongodb.net/?appName=应用名
# 注：专用的测试数据库（旧 TEST_MONGODB_URI / node index --test）已移除，
#     启动模式只有 `node index`、`node index webui`、`node index test`（test 只影响日志）。


# -----------------------------------------------------------------------------
# 管理员用户 ID [必填]
# -----------------------------------------------------------------------------
# 拥有 Bot 完整管理权限的 Telegram 用户 ID，多个用逗号分隔
# 获取方式：向 @userinfobot 发送任意消息即可看到 Your ID
ADMIN_CHAT_ID=第一个管理员ID, 第二个管理员ID


# -----------------------------------------------------------------------------
# Web UI 管理面板（可选）
# -----------------------------------------------------------------------------
# 启动方式：node index.js webui（或 npm run start:webui）
# 默认地址：http://127.0.0.1:9700
# 登录密码不再由此文件配置：请在数据库 settings 集合（_id = app_settings）
# 的文档中添加字段 webui_password（字符串）。未配置时无法登录。
WEBUI_PORT=9700


# -----------------------------------------------------------------------------
# 看门狗 watchdog.js（可选，推荐）
# -----------------------------------------------------------------------------
# 启动方式（参数与直接启动 bot 完全一致，崩溃后用同一份参数重启）：
#   node watchdog.js           -> node index.js
#   node watchdog.js webui     -> node index.js webui
#   node watchdog.js test      -> node index.js test
# 全部有默认值，不配置也能跑。
#
# 崩溃后多久重启（毫秒）
WATCHDOG_RESTART_DELAY=30000
# 健康轮询间隔 / 单次探测超时 / 连续失败几次判定软卡死
WATCHDOG_HEALTH_INTERVAL=30000
WATCHDOG_HEALTH_TIMEOUT=5000
WATCHDOG_HEALTH_FAILS=3
# 子进程启动后多久才开始判定健康（连接数据库 / 建索引本来就慢）
WATCHDOG_HEALTH_STARTUP_GRACE=60000
# 重启风暴保护：窗口内最多自动重启几次，超出则停止并提醒人工介入
WATCHDOG_MAX_RESTARTS=5
WATCHDOG_RESTART_WINDOW=600000
# 存活满多久算稳定（重置连续崩溃计数）
WATCHDOG_STABLE_MS=60000
# 重启前请求 bot 优雅退出的等待上限（Windows 无法发信号，走 POST /shutdown）
WATCHDOG_GRACEFUL_TIMEOUT=15000
# 通知模式：crash=崩溃即发（重启成功报告由主 bot 发）；after_restart=只在重启后发一条（含崩溃信息）；off=不发
WATCHDOG_NOTIFY_MODE=crash
# 崩溃播报进程的存活上限（它只负责发一条消息，发完/到点即自行结束）
WATCHDOG_NOTIFY_TTL=5000
# 崩溃 / 重启报告里最多列几条 warn/erro（用户要求：只展示最近 3 条）
WATCHDOG_REPORT_LINES=3
# 重启后多久仍未就绪则判定"重启失败"
NODE_RESTART_GRACE_MS=90000
# 健康检查端口（看门狗轮询 /health、POST /shutdown 都用它）
HEALTH_PORT=9699
# /shutdown 端点的共享密钥（留空则不校验；该端点已强制仅本机可调用）
HEALTH_SHUTDOWN_TOKEN=

# Web UI AI 辅助（可选，用于数据库增删改查，主要指 DeepSeek）
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=你的DeepSeek API密钥
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_TIMEOUT=60000


# -----------------------------------------------------------------------------
# MongoDB Atlas 白名单自动维护（可选，推荐给"走代理、出口 IP 经常变"的环境）
# -----------------------------------------------------------------------------
# 打开后：连不上数据库时会判断"是不是出口 IP 不在白名单"，是则自动把当前出口 IP
# 以**临时条目**加进项目的 Network Access（Security → Network Access），
# 到期由 Atlas 自动删除（默认 7 天 = 限期一周），不需要人工去控制台加。
# 启动连接失败、以及运行中心跳失败（掉线）都会触发；结果会给管理员发 Telegram 通知。
#
# 需要 Atlas 的 Admin API 凭据（项目 → Access Manager/组织 → API Keys 创建）：
#   1) 权限给 Project Owner（或最小化：能改项目 IP 访问列表的角色）；
#   2) **该 API Key 自己的 API Access List 必须设成 0.0.0.0/0（或留空）**，
#      否则你的 IP 一变，连"加白名单"这个接口都调不动（鸡生蛋）；
#   3) 创建后立刻复制 Private Key（只显示一次）。
# 注意：集群自身（项目 Network Access）不用开 0.0.0.0/0 —— 由本功能按当前 IP 维护临时条目。
ATLAS_AUTO_WHITELIST=0
# 项目 ID：Atlas → Project Settings → Project ID（24 位十六进制）
ATLAS_PROJECT_ID=
# Atlas API Key（走 HTTP Digest 认证）
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
# Admin API 地址（一般不用改；Atlas for Government 等特殊环境才需要）
ATLAS_API_BASE=https://cloud.mongodb.com
# 临时条目有效期（天）—— 用户要求：限期 1 周
ATLAS_WHITELIST_TTL_DAYS=7
# 冷却时间：这段时间内不重复尝试（毫秒），避免 Atlas 真挂了时反复调 API
ATLAS_WHITELIST_COOLDOWN_MS=600000
# 出口 IP 回显服务（依次尝试，取第一个能解析出 IP 的）
ATLAS_IP_LOOKUP_URLS=https://api.ipify.org,https://checkip.amazonaws.com,https://ifconfig.me/ip
# Atlas Admin API 请求超时（毫秒）
ATLAS_API_TIMEOUT_MS=15000
# 运行期数据库心跳间隔（毫秒）：掉线时触发同一套白名单维护
DB_GUARD_INTERVAL_MS=60000
